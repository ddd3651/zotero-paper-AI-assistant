{
  "name": "zotero-paper-chat",
  "version": "0.6.0",
  "private": true,
  "description": "在 Zotero 里边读论文边问 AI，支持 Codex 登录和外部模型 API",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "start": "node bridge/server.mjs",
    "probe": "node scripts/probe.mjs",
    "test": "node --test",
    "build": "node scripts/python.mjs scripts/build.py",
    "pack:source": "node scripts/python.mjs scripts/build.py --source",
    "check:publish": "node scripts/python.mjs scripts/project_files.py"
  }
}
